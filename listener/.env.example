# Copy this file to .env (in this folder) and fill it in. Never share .env or put it in Git.

# Bookr's address. For a test against Bookr on this computer: http://127.0.0.1:8787
BOOKR_URL=https://bookr.thebajajgroup.co

# The same value as the WA_INGEST_SECRET secret in Bookr (at least 16 characters).
BOOKR_SECRET=

# Optional. Bookr chooses the groups (Settings → WhatsApp groups). To limit this PC further, name a file with one
# group id per line (for example groups.txt); only groups in both lists are read.
# GROUPS_FILE=groups.txt

# Optional: debug for more detail in the log.
# LOG_LEVEL=info
