# Copy this file to .env (in this folder) and fill it in. Never share .env or put it in Git.

# Bookr's address. For a test against Bookr on this computer: http://127.0.0.1:8787
BOOKR_URL=https://bookr.thebajajgroup.co

# The same value as the WA_INGEST_SECRET secret in Bookr (at least 16 characters).
BOOKR_SECRET=

# Optional. Bookr chooses the groups (Settings → WhatsApp groups). To limit this PC further, name a file with one
# group id per line (for example groups.txt); only groups in both lists are read.
# GROUPS_FILE=groups.txt

# Optional: debug for more detail in the log.
# LOG_LEVEL=info

# Optional (25 Nov 2026): the morning Daily check PDF to the owner's own WhatsApp, once a day, until a WhatsApp Business
# number is ready. Off unless DAILY_TO and POS_REPORT_KEY are set. This is the only thing the listener ever sends.
# DAILY_TO=          the owner's WhatsApp number (10 digits, or with the country code)
# DAILY_AT=08:15     the time; it moves by up to DAILY_JITTER minutes each day
# DAILY_JITTER=10
# POS_URL=https://pos.thebajajgroup.co
# POS_BUSINESS_ID=   the restaurant's id in the POS
# POS_REPORT_KEY=    the same key as in the POS's Worker secret REPORT_KEYS
# CHROME_PATH=       only if Chrome or Edge is not found by itself
