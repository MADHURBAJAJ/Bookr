{
  "name": "bookr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed-demo:local": "tsx scripts/seed-demo.ts --local",
    "db:seed-demo:remote": "tsx scripts/seed-demo.ts --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:seed-demo-sales": "tsx scripts/seed-demo-sales.ts",
    "demo:images": "tsx scripts/make-demo-images.ts"
  },
  "dependencies": {
    "hono": "^4.6.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.20.0"
  }
}
