{
  "name": "bookr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:start": "docker run -d --name bookr-pg -e POSTGRES_PASSWORD=bookr -e POSTGRES_DB=bookr -p 54329:5432 postgres:16-alpine",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.20",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.20.0"
  }
}
