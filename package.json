{
  "name": "bookr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed-demo:local": "tsx scripts/seed-demo.ts --local",
    "db:seed-demo:remote": "tsx scripts/seed-demo.ts --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:seed-demo-sales": "tsx scripts/seed-demo-sales.ts",
    "demo:images": "tsx scripts/make-demo-images.ts",
    "ocr:accuracy": "tsx scripts/ocr-accuracy.ts",
    "pos:dev": "wrangler dev -c pos/wrangler.jsonc --port 8788",
    "pos:migrate:local": "wrangler d1 migrations apply DB --local -c pos/wrangler.jsonc",
    "pos:migrate:remote": "wrangler d1 migrations apply DB --remote -c pos/wrangler.jsonc",
    "pos:seed-demo:local": "tsx pos/scripts/seed-demo.ts --local",
    "pos:seed-demo:remote": "tsx pos/scripts/seed-demo.ts --remote",
    "pos:deploy": "wrangler deploy -c pos/wrangler.jsonc",
    "pos:reset-demo:remote": "tsx pos/scripts/seed-demo.ts --remote --keep-password"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "hono": "^4.6.20",
    "postal-mime": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.20.0"
  }
}
