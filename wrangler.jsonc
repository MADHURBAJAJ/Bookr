{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookr-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookr-demo",
      // Set by `wrangler d1 create bookr-demo`. An id, not a secret.
      "database_id": "85f66e7c-12f6-4565-9bbf-ad0fe246692d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      // Photos and CSVs with the NAME column blanked. Served only through the Worker after a role check.
      "bucket_name": "bookr-demo-uploads"
    }
  ],
  "observability": { "enabled": true }
}
